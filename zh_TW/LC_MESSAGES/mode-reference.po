"{\n"
"  classNameAliases: {\n"
"    slot: \"variable\",\n"
"    \"message-name\": \"string\"\n"
"  },\n"
"  contains: [\n"
"    {\n"
"      scope: \"slot\",\n"
"      begin: // ...\n"
"    }\n"
"  ]\n"
"}"
msgstr ""

#: ../../../mode-reference.rst:93
msgid ""
"The final HTML output will render slots with a CSS class of ``hljs-"
"variable``.  This feature exists to make it easier for grammar maintainers "
"to think in their own language when maintaining a grammar."
