#: ../../../plugin-api.rst:4
msgid "Plugin API"
msgstr ""

#: ../../../plugin-api.rst:6
msgid ""
"Highlight.js supports plugins.  You add plugins via the ``addPlugin`` API."
msgstr ""

#: ../../../plugin-api.rst:10
msgid ""
"// a plugin can be a class\n"
"addPlugin(new SimplePlugin());\n"
"addPlugin(new MoreComplexPlugin(options));\n"
"\n"
"// or simply a keyed object of functions\n"
"addPlugin({\n"
"  'after:highlightElement': ({ el, result, text }) => {\n"
"    // ...\n"
"  }\n"
"});"
msgstr ""

#: ../../../plugin-api.rst:22
msgid "Types of plugins"
msgstr ""

#: ../../../plugin-api.rst:25
msgid "Class based plugins"
msgstr ""

#: ../../../plugin-api.rst:27
msgid ""
"This approach is useful for more complex plugins that need to deal with "
"configuration options or managing state.  Highlight.js will instantiate a "
"single instance of your class and execute it's callbacks as necessary."
msgstr ""

#: ../../../plugin-api.rst:34
msgid ""
"class DataLanguagePlugin {\n"
"  constructor(options) {\n"
"    self.prefix = options.dataPrefix;\n"
"  }\n"
"\n"
"  'after:highlightElement'({ el, result, text }) {\n"
"    // ...\n"
"  }\n"
"}\n"
"\n"
"hljs.addPlugin(new DataLanguagePlugin({ dataPrefix: 'hljs' }));"
msgstr ""

#: ../../../plugin-api.rst:47
msgid "Function Based Plugins"
msgstr ""

#: ../../../plugin-api.rst:49
msgid "This approach is best for simpler plugins."
msgstr ""

#: ../../../plugin-api.rst:53
msgid ""
"hljs.addPlugin({\n"
"  'after:highlightElement': ({ el, result }) => {\n"
"    // move the language from the result into the dataset\n"
"    el.dataset.language = result.language;\n"
"  }\n"
"});"
msgstr ""

