#: ../../../api.rst:9 ../../../api.rst:236
msgid "highlight"
msgstr ""

#: ../../../api.rst:13
msgid "highlight(code, {language, ignoreIllegals})"
msgstr ""

#: ../../../api.rst:15
msgid ""
"Core highlighting function.  Accepts the code to highlight (string) and a "
"list of options (object). The ``language`` parameter must be present and "
"specify the language name or alias of the grammar to be used for "
"highlighting. The ``ignoreIllegals`` is an optional parameter that when "
"``true`` forces highlighting to finish even in case of detecting illegal "
"syntax for the language instead of throwing an exception."
msgstr ""

#: ../../../api.rst:22 ../../../api.rst:43
msgid "Returns an object with the following properties:"
msgstr ""

#: ../../../api.rst:24
msgid ""
"``language``: language name, same as the name passed in ``languageName``, "
"returned for consistency with ``highlightAuto``"
msgstr ""

#: ../../../api.rst:25 ../../../api.rst:46
msgid "``relevance``: integer value representing the relevance score"
msgstr ""

#: ../../../api.rst:26 ../../../api.rst:47
msgid "``value``: HTML string with highlighting markup"
msgstr ""

#: ../../../api.rst:27
msgid "``top``: top of the current mode stack"
msgstr ""

#: ../../../api.rst:28
msgid ""
"``illegal``: boolean representing whether any illegal matches were found"
msgstr ""

#: ../../../api.rst:29
msgid "``code``: the original raw code"
msgstr ""

#: ../../../api.rst:34
msgid "highlightAuto"
msgstr ""

#: ../../../api.rst:38
msgid "highlightAuto(code, languageSubset)"
msgstr ""

#: ../../../api.rst:40
msgid ""
"Highlighting with language detection. Accepts a string with the code to "
"highlight and an optional array of language names and aliases restricting "
"detection to only those languages. The subset can also be set with "
"``configure``, but the local parameter overrides the option if set."
msgstr ""

#: ../../../api.rst:45
msgid "``language``: detected language"
msgstr ""

#: ../../../api.rst:48
msgid ""
"``secondBest``: object with the same structure for second-best heuristically "
"detected language (may be absent)"
msgstr ""

#: ../../../api.rst:52
msgid "highlightElement"
msgstr ""

#: ../../../api.rst:56
msgid "highlightElement(element)"
msgstr ""

#: ../../../api.rst:58
msgid "Applies highlighting to a DOM node containing code."
msgstr ""

#: ../../../api.rst:60
msgid ""
"This function is the one to use to apply highlighting dynamically after page "
"load or within initialization code of third-party JavaScript frameworks."
msgstr ""

#: ../../../api.rst:63
msgid ""
"The function uses language detection by default but you can specify the "
"language in the ``class`` attribute of the DOM node. See the :doc:`scopes "
"reference </css-classes-reference>` for all available language names and "
"scopes."
msgstr ""

#: ../../../api.rst:71
msgid "highlightAll"
msgstr ""

#: ../../../api.rst:73
msgid ""
"Applies highlighting to all elements on a page matching the configured "
"``cssSelector``. The default ``cssSelector`` value is ``'pre code'``, which "
"highlights all code blocks. This can be called before or after the page's "
"``onload`` event has fired."
msgstr ""

#: ../../../api.rst:79
msgid "newInstance"
msgstr ""

#: ../../../api.rst:81
msgid "Returns a new instance of the highlighter with default configuration."
msgstr ""

#: ../../../api.rst:85
msgid "configure"
msgstr ""

#: ../../../api.rst:89
msgid "configure(options)"
msgstr ""

#: ../../../api.rst:91
msgid "Configures global options:"
msgstr ""

#: ../../../api.rst:93
msgid ""
"``classPrefix``: a string prefix added before class names in the generated "
"markup, used for backwards compatibility with stylesheets."
msgstr ""

#: ../../../api.rst:94
msgid ""
"``languages``: an array of language names and aliases restricting auto "
"detection to only these languages."
msgstr ""

#: ../../../api.rst:95
msgid ""
"``languageDetectRe``: a regex to configure how CSS class names map to "
"language (allows class names like say `color-as-php` vs the default of "
"`language-php`, etc.)"
msgstr ""

#: ../../../api.rst:96
msgid ""
"``noHighlightRe``: a regex to configure which CSS classes are to be skipped "
"completely."
msgstr ""

#: ../../../api.rst:97
msgid ""
"``cssSelector``: a CSS selector to configure which elements are affected by "
"``hljs.highlightAll``. Defaults to ``'pre code'``."
msgstr ""

#: ../../../api.rst:98
msgid ""
"``ignoreUnescapedHTML``: do not log warnings to console about unescaped HTML "
"in code blocks"
msgstr ""

#: ../../../api.rst:99
msgid ""
"``throwUnescapedHTML``: throw a ``HTMLInjectionError`` when "
"``highlightElement`` is asked to highlight content that includes unescaped "
"HTML"
msgstr ""

#: ../../../api.rst:102
msgid ""
"Accepts an object representing options with the values to updated. Other "
"options don't change ::"
msgstr ""

#: ../../../api.rst:105
msgid ""
"hljs.configure({\n"
"  noHighlightRe: /^do-not-highlightme$/i,\n"
"  languageDetectRe: /\\bgrammar-([\\w-]+)\\b/i, // for `grammar-swift` style "
"CSS naming\n"
"  classPrefix: ''     // don't append class prefix\n"
"                      // … other options aren't changed\n"
"});"
msgstr ""

