#: ../../../plugin-recipes.rst:4
msgid "Plugin Recipes"
msgstr ""

#: ../../../plugin-recipes.rst:6
msgid ""
"Below is a collection of useful plugin \"recipes\" that you might find "
"helpful."
msgstr ""

#: ../../../plugin-recipes.rst:10
msgid "data-language"
msgstr ""

#: ../../../plugin-recipes.rst:12
msgid ""
"Let's say you'd like to track the language that was auto-detected via a "
"`data attribute <https://developer.mozilla.org/en-US/docs/Learn/HTML/Howto/"
"Use_data_attributes>`_. This might prove useful if you desired to add a "
"dynamic label via CSS with ``:before``, etc."
msgstr ""

#: ../../../plugin-recipes.rst:19
msgid ""
"hljs.addPlugin( {\n"
"  'after:highlightElement': ({el, result}) => {\n"
"    // move the language from the result into the dataset\n"
"    el.dataset.language = result.language }\n"
"})"
msgstr ""
